<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
            <title>Lagos Hustle: Traffic Edition</title>
                <style>
                        body {
                                    margin: 0; padding: 0; background: #111; color: #fff;
                                                font-family: sans-serif; overflow: hidden; user-select: none;
                                                        }
                                                                #gameCanvas { display: block; background: #2e7d32; margin: 0 auto; }
                                                                        #ui-overlay {
                                                                                    position: absolute; top: 10px; left: 10px;
                                                                                                font-size: 16px; font-weight: bold; text-shadow: 2px 2px #000; z-index: 10;
                                                                                                        }
                                                                                                                .controls {
                                                                                                                            position: absolute; bottom: 20px; width: 100%;
                                                                                                                                        display: flex; justify-content: space-between; padding: 0 20px; box-sizing: border-box; z-index: 10;
                                                                                                                                                }
                                                                                                                                                        .d-pad, .action-buttons { display: grid; gap: 5px; }
                                                                                                                                                                .d-pad { grid-template-columns: repeat(3, 60px); }
                                                                                                                                                                        .action-buttons { grid-template-columns: repeat(2, 70px); }
                                                                                                                                                                                button {
                                                                                                                                                                                            width: 60px; height: 60px; background: rgba(255, 255, 255, 0.3);
                                                                                                                                                                                                        border: 2px solid #fff; color: white; border-radius: 50%; font-size: 18px; font-weight: bold;
                                                                                                                                                                                                                }
                                                                                                                                                                                                                        button:active { background: rgba(255, 255, 255, 0.6); }
                                                                                                                                                                                                                                .btn-action { width: 70px; height: 70px; border-radius: 10px; background: rgba(255, 200, 0, 0.5); }
                                                                                                                                                                                                                                    </style>
                                                                                                                                                                                                                                    </head>
                                                                                                                                                                                                                                    <body>

                                                                                                                                                                                                                                    <div id="ui-overlay">
                                                                                                                                                                                                                                        <div>Naira: ₦<span id="cash">500</span></div>
                                                                                                                                                                                                                                            <div>Wanted Level: <span id="wanted">⭐☆☆☆☆</span></div>
                                                                                                                                                                                                                                                <div>Location: <span id="zone">Walking on Street</span></div>
                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                <canvas id="gameCanvas"></canvas>

                                                                                                                                                                                                                                                <div class="controls">
                                                                                                                                                                                                                                                    <div class="d-pad">
                                                                                                                                                                                                                                                            <div></div><button id="btn-up">▲</button><div></div>
                                                                                                                                                                                                                                                                    <button id="btn-left">◀</button><div></div><button id="btn-right">▶</button>
                                                                                                                                                                                                                                                                            <div></div><button id="btn-down">▼</button><div></div>
                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                    <div class="action-buttons">
                                                                                                                                                                                                                                                                                            <button class="btn-action" id="btn-hustle">MISSION</button>
                                                                                                                                                                                                                                                                                                    <button class="btn-action" id="btn-enter" style="background: rgba(255,0,0,0.5)">HIJACK</button>
                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                        <script>
                                                                                                                                                                                                                                                                                                            const canvas = document.getElementById("gameCanvas");
                                                                                                                                                                                                                                                                                                                const ctx = canvas.getContext("2d");

                                                                                                                                                                                                                                                                                                                    canvas.width = window.innerWidth;
                                                                                                                                                                                                                                                                                                                        canvas.height = window.innerHeight;

                                                                                                                                                                                                                                                                                                                            // Player Properties (Your Yellow Danfo)
                                                                                                                                                                                                                                                                                                                                let player = { x: canvas.width / 2, y: canvas.height / 2, size: 25, speed: 4, color: "#FFCC00" };

                                                                                                                                                                                                                                                                                                                                    // Roads and Landmarks
                                                                                                                                                                                                                                                                                                                                        let roads = [
                                                                                                                                                                                                                                                                                                                                                { x: 0, y: canvas.height / 2 - 40, width: canvas.width, height: 80 }, 
                                                                                                                                                                                                                                                                                                                                                        { x: canvas.width / 3 - 40, y: 0, width: 80, height: canvas.height }  
                                                                                                                                                                                                                                                                                                                                                            ];

                                                                                                                                                                                                                                                                                                                                                                let buildings = [
                                                                                                                                                                                                                                                                                                                                                                        { name: "Oshodi Danfo Park", x: 40, y: 40, width: 140, height: 100, color: "#37474f" },
                                                                                                                                                                                                                                                                                                                                                                                { name: "LASTMA Roadblock", x: canvas.width - 160, y: canvas.height / 2 - 35, width: 30, height: 70, color: "#d84315" },
                                                                                                                                                                                                                                                                                                                                                                                        { name: "Local Mama Put Shop", x: canvas.width / 2 + 20, y: canvas.height - 150, width: 120, height: 90, color: "#8d6e63" }
                                                                                                                                                                                                                                                                                                                                                                                            ];

                                                                                                                                                                                                                                                                                                                                                                                                // --- STEP 3: TRAFFIC SYSTEM ---
                                                                                                                                                                                                                                                                                                                                                                                                    // Creating random moving vehicles on the main expressway
                                                                                                                                                                                                                                                                                                                                                                                                        let traffic = [
                                                                                                                                                                                                                                                                                                                                                                                                                { x: 0, y: canvas.height / 2 - 25, size: 20, speed: 2, color: "#FFA500", label: "Keke" }, // Orange Keke Napep
                                                                                                                                                                                                                                                                                                                                                                                                                        { x: canvas.width / 2, y: canvas.height / 2 + 10, size: 25, speed: -3, color: "#FFCC00", label: "Danfo" }, // Other Danfo going left
                                                                                                                                                                                                                                                                                                                                                                                                                                { x: canvas.width, y: canvas.height / 2 - 20, size: 22, speed: -1.5, color: "#ffffff", label: "Car" } // White local car
                                                                                                                                                                                                                                                                                                                                                                                                                                    ];

                                                                                                                                                                                                                                                                                                                                                                                                                                        let moveUp = false, moveDown = false, moveLeft = false, moveRight = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                            let currentZone = "Lagos Mainland";

                                                                                                                                                                                                                                                                                                                                                                                                                                                function draw() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.fillStyle = "#2e7d32";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.fillRect(0, 0, canvas.width, canvas.height);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                        // Draw Roads
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.fillStyle = "#424242";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        roads.forEach(road => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.fillRect(road.x, road.y, road.width, road.height);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.strokeStyle = "#ffeb3b";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.lineWidth = 2;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.beginPath();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (road.width > road.height) { 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.moveTo(road.x, road.y + road.height / 2);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.lineTo(road.x + road.width, road.y + road.height / 2);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } else { 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.moveTo(road.x + road.width / 2, road.y);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.lineTo(road.x + road.width / 2, road.y + road.height);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.stroke();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        // Draw Buildings
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                buildings.forEach(bld => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillStyle = bld.color;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.fillRect(bld.x, bld.y, bld.width, bld.height);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.fillStyle = "#ffffff";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ctx.font = "12px sans-serif";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.textAlign = "center";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.fillText(bld.name, bld.x + bld.width / 2, bld.y + bld.height / 2);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        // Draw Traffic Vehicles
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                traffic.forEach(car => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillStyle = car.color;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.fillRect(car.x, car.y, car.size * 1.3, car.size);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // Put a small letter tag so you know what it is
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillStyle = "#000";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ctx.font = "10px Arial";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.fillText(car.label[0], car.x + 5, car.y + car.size - 5);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // Draw Player
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillStyle = player.color;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.fillRect(player.x - player.size / 2, player.y - player.size / 2, player.size, player.size * 1.4);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillStyle = "#000";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ctx.fillRect(player.x - player.size / 2, player.y - player.size / 5, player.size, 4);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ctx.fillRect(player.x - player.size / 2, player.y + player.size / 4, player.size, 4);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    function update() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (moveUp && player.y > 0) player.y -= player.speed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (moveDown && player.y < canvas.height) player.y += player.speed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (moveLeft && player.x > 0) player.x -= player.speed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (moveRight && player.x < canvas.width) player.x += player.speed;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // Move Traffic Vehicles automatically
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    traffic.forEach(car => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                car.x += car.speed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // If car goes off screen to the right, reset to the left
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if (car.speed > 0 && car.x > canvas.width) car.x = -40;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // If car goes off screen to the left, reset to the right
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (car.speed < 0 && car.x < -40) car.x = canvas.width;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // Check if player is touching any building zone
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        currentZone = "Lagos Streets";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                buildings.forEach(bld => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (player.x > bld.x && player.x < bld.x + bld.width &&
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            player.y > bld.y && player.y < bld.y + bld.height) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            currentZone = bld.name;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        document.getElementById("zone").innerText = currentZone;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function gameLoop() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        update();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                draw();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        requestAnimationFrame(gameLoop);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function setupTouchBtn(id, pressCallback, releaseCallback) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const btn = document.getElementById(id);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                btn.addEventListener("touchstart", (e) => { e.preventDefault(); pressCallback(); });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        btn.addEventListener("touchend", (e) => { e.preventDefault(); releaseCallback(); });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                setupTouchBtn("btn-up", () => moveUp = true, () => moveUp = false);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    setupTouchBtn("btn-down", () => moveDown = true, () => moveDown = false);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        setupTouchBtn("btn-left", () => moveLeft = true, () => moveLeft = false);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            setupTouchBtn("btn-right", () => moveRight = true, () => moveRight = false);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                gameLoop();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </script>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </body>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </html>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                